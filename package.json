{
  "name": "@local/dsh-date-sundial",
  "version": "1.0.0",
  "description": "A quiet date-progress strip beneath the DeepSeek Harness composer.",
  "type": "module",
  "license": "MIT",
  "author": "evanP-d",
  "homepage": "https://github.com/evanP-d/dsh-date-sundial#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanP-d/dsh-date-sundial.git"
  },
  "bugs": {
    "url": "https://github.com/evanP-d/dsh-date-sundial/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "date", "year-progress", "ambient"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
